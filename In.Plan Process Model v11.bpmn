        <bpmn:textAnnotation id="TextAnnotation_0jht541">
          <bpmn:text>настройка границ приоритета</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_16jxk08">
          <bpmn:text>Алерт по Low Stock:
Планируемый запас &lt; Целевой запас</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0tca1q4">
          <bpmn:text>Алерт по Out of Stock:
Планируемый запас &lt; Страховой запас</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1wsvudw">
          <bpmn:text>Алерт по Over Stock:
Планируемый запас &gt; Целевой запас и Покрытие запасом &lt; Пороговое значение</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_05dbnek">
          <bpmn:text>Алерт по неликвидам:
Если Покрытие запасом &gt; Пороговое значение (по-умолчанию 365 дней), считать не ликвидом</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0bkuu2e">
          <bpmn:text>переделать в передачу в S&amp;OP</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0nmbncm">
          <bpmn:text>переделать в передачу в S&amp;OP</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1llq857">
          <bpmn:text>переход в сценарии для S&amp;OP</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1r9zm0r">
          <bpmn:text>выносить на Supply Review (S&amp;OP)</bpmn:text>
        </bpmn:textAnnotation>
      </bpmn:subProcess>
