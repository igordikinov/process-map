      <bpmn:dataObjectReference id="DataObjectReference_1prg22w" name="✅остатки и страховые запасы;&#10;✅существующие заказы на поставку и заявки на закупку;&#10;✅перемещения (входящие/исходящие);&#10;✅&#10;параметры партии (min/max/кратность, периодичность) и календари — для корректной «нарезки» потребности во времени" dataObjectRef="DataObject_0ssu0gy" />
      <bpmn:dataObject id="DataObject_0ssu0gy" />
      <bpmn:dataObjectReference id="DataObjectReference_18i2tv0" name="Рассчитанные нетто-потребности»:&#10;✅нетто-потребность по каждому материалу/локации/периоду;&#10;✅учтённые остатки и существующие заказы;&#10;✅потенциальные дефициты/излишки;&#10;✅ список предупреждений по отрицательным остаткам и т.п." dataObjectRef="DataObject_0egmshl" />
      <bpmn:dataObject id="DataObject_0egmshl" />
      <bpmn:dataObjectReference id="DataObjectReference_0kqaea8" name="параметры закупки:&#10;✅lead time, MOQ, min/max партия, кратность, периодичность;&#10;✅источник поставки, квоты, цены;&#10;✅данные по поставщикам и логистическим ограничениям:&#10;✅календарь поставщика, окна отгрузки;&#10;✅ограничения по объёмам/мощностям;&#10;✅транспортные ограничения (тип транспорта, вместимость)." dataObjectRef="DataObject_1ya1gia" />
