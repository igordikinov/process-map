        <bpmn:textAnnotation id="TextAnnotation_0eb9dc9">
          <bpmn:text>Алерт по Low Stock:
Планируемый запас &lt; Целевой запас</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1pc86e5">
          <bpmn:text>1) Расширение доступности  мощностей                        2) Продажи: Сдвиг производства (и целевой даты готовности) ГП под дату поставки СиМ или доступных мощностей,
3) Технологи: замена компонентов ГП на имеющиеся аналоги</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1bgfym3">
          <bpmn:text>Экран анализа результатов</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0gcjtdo">
          <bpmn:text>Тепловая карта</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1s8hltf">
          <bpmn:text>Ведомость обеспеченности</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1djx34k">
          <bpmn:text>Экран анализа результатов</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_08je1q3">
          <bpmn:text>Алерт по Out of Stock:
Планируемый запас &lt; Страховой запас</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_1agpo9f">
          <bpmn:text>Алерты по перегрузам в  Тепловой карте</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0dmvc85">
          <bpmn:text>Алерт по нарушению сроков выхода ГП</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:textAnnotation id="TextAnnotation_0cdvqsn">
          <bpmn:text>Алерты дефициту СиМ / ТуМ</bpmn:text>
        </bpmn:textAnnotation>
      </bpmn:subProcess>
