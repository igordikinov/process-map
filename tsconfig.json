{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],

    // Алиас данных карты. Статически указывает на карту по умолчанию:
    // tsc проверяет ТИПЫ, а они у всех карт одни (schema.ts), и
    // parseProcessMap всё равно принимает unknown и валидирует зодом в
    // рантайме. Реальный путь на сборке подставляет resolve.alias из
    // scripts/mapTarget.ts (process-map-3wh.6).
    "baseUrl": ".",
    "paths": { "@map/*": ["src/data/snp/*"] }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
